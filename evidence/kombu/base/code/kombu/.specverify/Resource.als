module Resource
-- Golden structural model of kombu.resource.Resource: the properties that
-- HELD on the base tree, so a later change that breaks one is a regression.
-- (The full R154-style model with the known limit violation is Resource-full.als
-- beside this file; a golden guards only what held.)
-- Skeleton generated by specforge_engine.skeleton.alloy from the base tree.

open util/ordering[State]

sig Thread {}
sig Elem {}

one sig Cfg { limit: Int }
-- @code code.kombu.resource.Resource.acquire
fact LimitOne { Cfg.limit = 1 }

sig State {
  _closed: Int,
  _resource: set Elem,
  _dirty: set Elem
}

pred init[s: State] {
  s._closed = 0
  no s._resource
  no s._dirty
}

-- @code code.kombu.resource.Resource._add_when_empty
pred Op_add[s, s2: State, t: Thread] {
  some e: Elem - (s._resource + s._dirty) {
    #s._dirty < Cfg.limit
    s2._resource = s._resource + e
    s2._dirty = s._dirty
    s2._closed = s._closed
  }
}

-- @code code.kombu.resource.Resource.acquire
pred Op_take[s, s2: State, t: Thread] {
  some e: s._resource {
    s2._resource = s._resource - e
    s2._dirty = s._dirty + e
    s2._closed = s._closed
  }
}

-- release (resource.py:136): discard from _dirty, then re-queue.
-- @code code.kombu.resource.Resource.release
pred Op_release[s, s2: State, t: Thread] {
  some e: s._dirty {
    s2._resource = s._resource + e
    s2._dirty = s._dirty - e
    s2._closed = s._closed
  }
}

pred step[s, s2: State] {
  some t: Thread | Op_add[s, s2, t] or Op_take[s, s2, t] or Op_release[s, s2, t]
}

-- @code code.kombu.resource.Resource.acquire code.kombu.resource.Resource.release
-- the state changes only through Resource's operations, from init
fact Trace {
  init[first]
  all s: State - last | step[s, s.next]
}

run Witness { some s: State | s != first } for 5 State, 2 Thread, 3 Elem, 3 Int

-- Claim: a resource is never both queued and checked out at once.
assert NoDoubleHold {
  all s: State | no (s._resource & s._dirty)
}
check NoDoubleHold for 5 State, 2 Thread, 3 Elem, 3 Int
