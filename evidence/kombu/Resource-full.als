module Resource
-- Structural model of kombu.resource.Resource (pattern: relational-properties).
-- Skeleton generated by specforge_engine.skeleton.alloy from
-- benchmarks/cleanroom/kombu/pkt-a (Resource at code/kombu/resource.py:33);
-- operation semantics and asserts completed by hand, following the R154 pilot
-- arc (snapshot relations + two-state op predicates over an ordered trace).
-- acquire is split into its check (Op_add) and its take (Op_take) because the
-- code separates them: _add_when_empty tests len(_dirty) >= limit
-- (resource.py:59) while _dirty.add happens later in acquire (resource.py:99).

open util/ordering[State]

sig Thread {}
sig Elem {}

-- The pool's bound, instantiated at 1: the smallest limit that exposes the shape.
one sig Cfg { limit: Int }
-- @code code.kombu.resource.Resource.acquire
fact LimitOne { Cfg.limit = 1 }

sig State {
  _closed: Int,
  _resource: set Elem,
  _dirty: set Elem
}

pred init[s: State] {
  s._closed = 0
  no s._resource
  no s._dirty
}

-- @code code.kombu.resource.Resource._add_when_empty
pred Op_add[s, s2: State, t: Thread] {
  some e: Elem - (s._resource + s._dirty) {
    #s._dirty < Cfg.limit
    s2._resource = s._resource + e
    s2._dirty = s._dirty
    s2._closed = s._closed
  }
}

-- @code code.kombu.resource.Resource.acquire
pred Op_take[s, s2: State, t: Thread] {
  some e: s._resource {
    s2._resource = s._resource - e
    s2._dirty = s._dirty + e
    s2._closed = s._closed
  }
}

-- @code code.kombu.resource.Resource.release
pred Op_release[s, s2: State, t: Thread] {
  some e: s._dirty {
    s2._resource = s._resource + e
    s2._dirty = s._dirty - e
    s2._closed = s._closed
  }
}

pred step[s, s2: State] {
  some t: Thread | Op_add[s, s2, t] or Op_take[s, s2, t] or Op_release[s, s2, t]
}

-- @code code.kombu.resource.Resource.acquire code.kombu.resource.Resource.release
-- the state changes only through Resource's operations, from init
fact Trace {
  init[first]
  all s: State - last | step[s, s.next]
}

run Witness { some s: State | #s._dirty = 2 } for 5 State, 2 Thread, 3 Elem, 3 Int

-- Claim: the pool never holds more checked-out resources than its limit.
assert NoOverLimit {
  all s: State | #s._dirty <= Cfg.limit
}
check NoOverLimit for 5 State, 2 Thread, 3 Elem, 3 Int

-- Claim: a resource is never both queued and checked out at once.
assert NoDoubleHold {
  all s: State | no (s._resource & s._dirty)
}
check NoDoubleHold for 5 State, 2 Thread, 3 Elem, 3 Int
